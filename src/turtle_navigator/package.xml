<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtle_navigator</name>
  <version>0.1.0</version>
  <description>A ROS 2 autonomous turtle navigation system with a Qt GUI, goal validation, action-based navigation, and real-time monitoring.</description>

  <maintainer email="ahmmedsammy2004@gmail.com">Ahmed Samy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>turtlesim_msgs</depend>
  <depend>turtle_navigator_interfaces</depend>
  <depend>qt-base-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>turtlesim</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
